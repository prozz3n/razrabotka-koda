<Page x:Class="Desktop.View.LoginPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#F5F6FA"
      FontFamily="Segoe UI">

    <Page.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="LogoImage"
                                     Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.5" />
                    <DoubleAnimation Storyboard.TargetName="LogoTranslate"
                                     Storyboard.TargetProperty="Y"
                                     From="-40" To="0" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <BackEase EasingMode="EaseOut" Amplitude="0.4" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>

                    <DoubleAnimation Storyboard.TargetName="LoginScale"
                                     Storyboard.TargetProperty="ScaleX"
                                     From="0.9" To="1" Duration="0:0:0.45">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="LoginScale"
                                     Storyboard.TargetProperty="ScaleY"
                                     From="0.9" To="1" Duration="0:0:0.45">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Page.Triggers>

    <Grid Margin="40,36">
        <StackPanel VerticalAlignment="Center" MaxWidth="340">
            <Image x:Name="LogoImage" Source="pack://application:,,,/images/logo.png"
                   Width="96" Height="96" HorizontalAlignment="Center">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="LogoTranslate" />
                </Image.RenderTransform>
            </Image>
            <TextBlock Text="Todo" FontSize="32" FontWeight="Bold"
                       Foreground="#2D3436" HorizontalAlignment="Center"
                       Margin="0,18,0,4" />
            <TextBlock Text="Войдите в свой аккаунт" FontSize="14"
                       Foreground="#636E72" HorizontalAlignment="Center"
                       Margin="0,0,0,32" />

            <TextBlock Text="Email" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="EmailBox" Style="{StaticResource RoundedTextBox}" />

            <TextBlock Text="Пароль" Style="{StaticResource FieldLabel}"
                       Margin="2,18,0,6" />
            <PasswordBox x:Name="PasswordBox" Style="{StaticResource RoundedPasswordBox}" />

            <Button Content="ВОЙТИ" Style="{StaticResource PrimaryButton}"
                    Margin="0,32,0,0" Click="Login_Click"
                    RenderTransformOrigin="0.5,0.5">
                <Button.RenderTransform>
                    <ScaleTransform x:Name="LoginScale" />
                </Button.RenderTransform>
            </Button>

            <TextBlock Text="Нет аккаунта?" FontSize="13" Foreground="#636E72"
                       HorizontalAlignment="Center" Margin="0,26,0,8" />
            <Button Content="Регистрация" Style="{StaticResource SecondaryButton}"
                    Click="GoToRegistration_Click" />
        </StackPanel>
    </Grid>
</Page>
