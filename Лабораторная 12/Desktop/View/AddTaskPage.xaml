<Page x:Class="Desktop.View.AddTaskPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#F5F6FA"
      FontFamily="Segoe UI">

    <Grid Margin="28,24">
        <StackPanel MaxWidth="440" HorizontalAlignment="Center">
            <TextBlock Text="Новая задача" FontSize="22" FontWeight="Bold"
                       Foreground="#2D3436" Margin="0,0,0,20" />

            <TextBlock Text="Название" Style="{StaticResource FieldLabel}" />
            <TextBox Style="{StaticResource RoundedTextBox}"
                     Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Описание" Style="{StaticResource FieldLabel}"
                       Margin="2,16,0,6" />
            <TextBox Height="110" FontSize="14"
                     Padding="12,8" TextWrapping="Wrap" AcceptsReturn="True"
                     VerticalScrollBarVisibility="Auto"
                     Background="White" BorderBrush="#DFE6E9" BorderThickness="1"
                     Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Text="Категория" Style="{StaticResource FieldLabel}"
                       Margin="2,16,0,6" />
            <ComboBox Height="44" FontSize="14"
                      VerticalContentAlignment="Center" Padding="10,0"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding Category, Mode=TwoWay}" />

            <TextBlock Text="Дата" Style="{StaticResource FieldLabel}"
                       Margin="2,16,0,6" />
            <DatePicker Height="44" FontSize="14"
                        VerticalContentAlignment="Center"
                        SelectedDate="{Binding Date, Mode=TwoWay}" />

            <Grid Margin="0,26,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Отмена"
                        Style="{StaticResource SecondaryButton}"
                        Command="{Binding CancelCommand}" />
                <Button Grid.Column="2" Content="Сохранить"
                        Style="{StaticResource PrimaryButton}"
                        Command="{Binding SaveCommand}" />
            </Grid>
        </StackPanel>
    </Grid>
</Page>
