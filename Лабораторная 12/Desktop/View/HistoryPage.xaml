<Page x:Class="Desktop.View.HistoryPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d"
      Background="#F5F6FA"
      FontFamily="Segoe UI">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="24,16">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <Button Content="← Назад" Style="{StaticResource GhostButton}"
                            Command="{Binding BackCommand}" />
                    <TextBlock Text="История выполненных задач" FontSize="18"
                               FontWeight="Bold" Foreground="#2D3436"
                               VerticalAlignment="Center" Margin="16,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Counter}" HorizontalAlignment="Right"
                           VerticalAlignment="Center" Foreground="#B2BEC3" />
            </Grid>
        </Border>

        <ListBox Grid.Row="1" Margin="18"
                 ItemsSource="{Binding Tasks}"
                 BorderThickness="0" Background="Transparent"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="White" CornerRadius="12"
                            Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="{Binding Title}" FontSize="15"
                                           FontWeight="SemiBold" Foreground="#2D3436"
                                           TextWrapping="Wrap" Margin="0,0,80,0" />
                                <TextBlock Text="{Binding Date, StringFormat=dd.MM.yyyy}"
                                           Foreground="#B2BEC3"
                                           HorizontalAlignment="Right" />
                            </Grid>
                            <TextBlock Text="{Binding Category}" Foreground="#6C5CE7"
                                       FontSize="12" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding Description}"
                                       TextWrapping="Wrap" Foreground="#636E72"
                                       Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</Page>
