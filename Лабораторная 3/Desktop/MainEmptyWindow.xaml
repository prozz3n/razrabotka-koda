<Window x:Class="Desktop.MainEmptyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Todo"
        Height="640" Width="980"
        WindowStartupLocation="CenterScreen"
        Background="#F5F6FA"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="46" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="#6C5CE7" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#5A4BD6" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#4B3FC0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#6C5CE7" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   VerticalAlignment="Center" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" Padding="28,14">
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Image Source="images/logo.png" Width="34" Height="34" />
                    <TextBlock Text="Todo" FontSize="20" FontWeight="Bold"
                               Foreground="#2D3436" VerticalAlignment="Center"
                               Margin="12,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Ellipse Width="36" Height="36" Fill="#EEF0FB" />
                    <TextBlock x:Name="UserNameText" Text="Пользователь"
                               VerticalAlignment="Center" Margin="10,0,18,0"
                               FontSize="14" Foreground="#2D3436" />
                    <Button Content="Выйти" Style="{StaticResource LinkButton}"
                            Click="Logout_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" VerticalAlignment="Center"
                    HorizontalAlignment="Center">
            <Border Width="104" Height="104" CornerRadius="52"
                    Background="#EEF0FB" HorizontalAlignment="Center">
                <TextBlock Text="+" FontSize="56" FontWeight="Light"
                           Foreground="#6C5CE7"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <TextBlock Text="У вас пока нет задач" FontSize="24" FontWeight="Bold"
                       Foreground="#2D3436" HorizontalAlignment="Center"
                       Margin="0,26,0,8" />
            <TextBlock Text="Создайте первую задачу, чтобы начать работу"
                       FontSize="15" Foreground="#636E72"
                       HorizontalAlignment="Center" Margin="0,0,0,28" />

            <Button Content="Добавить задачу" Style="{StaticResource PrimaryButton}"
                    Width="220" HorizontalAlignment="Center"
                    Click="AddTask_Click" />
        </StackPanel>
    </Grid>
</Window>
